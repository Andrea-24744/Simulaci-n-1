			<Events>
				<Event>
					<Id>1750886675233</Id>
					<Name><![CDATA[eventoDiario]]></Name>
					<X>100</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<Id>1750886675231</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1750924800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[int GallinasJovenes = (int)(proporcionjovenes * Totalgallinas);
int GallinasViejas = Totalgallinas - GallinasJovenes;

if (DiaActual <= díasproducción) {

    HuevosHoy = 0;

    // Huevos producidos hoy por gallinas jóvenes
    int huevosDeGallinasJovenes = binomial(0.9, GallinasJovenes);

    // Huevos producidos hoy por gallinas viejas
    int huevosDeGallinasViejas = binomial(0.6, GallinasViejas);

    // Total de huevos producidos hoy
    HuevosHoy = huevosDeGallinasJovenes + huevosDeGallinasViejas;

    // Sumar al total acumulado
    HuevosTotales += HuevosHoy;

    // Actualizar las gráficas
    produccionDiaria.add(DiaActual, HuevosHoy);
    produccionAcumulada.add(DiaActual, HuevosTotales);

    // Aquí vamos a crear los huevos físicos en la cinta:
    for (int i = 0; i < huevosDeGallinasJovenes; i++) {
        source.inject(); // Crear cada huevo joven
    }    
    HuevJoveTotal += huevosDeGallinasJovenes;
    

    for (int i = 0; i < huevosDeGallinasViejas; i++) {
        source1.inject(); // Crear cada huevo viejo
    }
    HuevViejTotal += huevosDeGallinasViejas;
    
    
    // Avanzar al siguiente día
    DiaActual++;

} else {
    eventoDiario.cancel();
    trace("Total de huevos producidos: " + HuevosTotales);
    stop();
}

]]></Action>
				</Event>
			</Events>
